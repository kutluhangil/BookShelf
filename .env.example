# --- Gemini (server side) ---
# Required for the /api/gemini/* endpoints (shelf recognition, OCR, recommendations).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Gemini model used by the server. Override only if you know the model exists.
GEMINI_MODEL="gemini-2.5-flash"

# --- Server ---
PORT=3000

# --- API authentication ---
# The Gemini endpoints cost money per call, so they require a signed-in user in
# production. Set REQUIRE_AUTH=true to enforce it in development too.
# In production REQUIRE_AUTH=false is refused and the server will not start.
REQUIRE_AUTH=false

# Needed when authentication is enforced. Either paste the service account JSON
# into FIREBASE_SERVICE_ACCOUNT, or point GOOGLE_APPLICATION_CREDENTIALS at the
# file and set only FIREBASE_PROJECT_ID.
FIREBASE_PROJECT_ID=""
FIREBASE_SERVICE_ACCOUNT=""


# APP_URL: public origin where this app is hosted. Used to build shareable links.
APP_URL="http://localhost:3000"

# --- Firebase (client side, exposed to the browser by Vite) ---
# Create a Web App in the Firebase console and copy the config values here.
# Cloud sync, Google sign-in and shared lists stay disabled while these are empty.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
